{
  "name": "human-machine-judgment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation of Judgment Points: durable, machine-readable decision records for consequential choices in technical agent workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/STEIDd/HumanMachineJudgment.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "test:python": "cd backend && uv run pytest",
    "lint:python": "cd backend && uv run ruff check .",
    "typecheck:python": "cd backend && uv run mypy .",
    "format:python": "cd backend && uv run ruff format --check .",
    "validate": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:python && pnpm run lint:python && pnpm run typecheck:python && pnpm run format:python",
    "validate:schemas": "pnpm --filter @human-machine-judgment/schemas run validate",
    "dev:docs": "pnpm --filter @human-machine-judgment/documentation run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
