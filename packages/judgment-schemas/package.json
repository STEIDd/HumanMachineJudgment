{
  "name": "@human-machine-judgment/schemas",
  "version": "0.1.0",
  "description": "JSON schemas and schema validation for Judgment Points interoperability.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/STEIDd/HumanMachineJudgment.git",
    "directory": "packages/judgment-schemas"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "validate": "node --import tsx src/validate-schemas.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.7"
  }
}
