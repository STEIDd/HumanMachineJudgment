{
  "name": "@human-machine-judgment/reference-server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Reference HTTP API server for Judgment Points.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
